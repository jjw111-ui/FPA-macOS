OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
# Per-task timeout; local settings allow 1–5 minutes.
OPENAI_IMAGE_TIMEOUT_MS=300000
# Simultaneous generation tasks (1–8); additional tasks wait in order.
OPENAI_IMAGE_CONCURRENCY=2

# Add a PNG at data/model-reference.png or point to another local file.
WARDROBE_MODEL_REFERENCE=data/model-reference.png
