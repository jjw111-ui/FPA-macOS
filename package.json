{
  "name": "fpa-macos",
  "version": "1.0.0",
  "private": true,
  "description": "FPA macOS desktop package and local design workspace.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-full-paint.mjs && vite build",
    "build:paint": "node scripts/build-full-paint.mjs",
    "start:portable": "node scripts/portable-server.mjs --open",
    "build:macos": "bash packaging/macos/build-app.sh",
    "verify:macos": "node scripts/verify-macos-project.mjs",
    "preview": "vite preview",
    "check": "npm run build",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@unpic/react": "^1.0.2",
    "@vitejs/plugin-react": "5.0.4",
    "ipx": "^3.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.34.5",
    "vite": "6.4.3"
  }
}
